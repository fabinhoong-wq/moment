# Copie este arquivo para .env e preencha com seus valores
NODE_ENV=development
PORT=3000

# String de conexão do banco Postgres (Neon ou Supabase, plano gratuito).
# Pegue em: painel do Neon/Supabase → Connection string.
# No Render, essa mesma variável entra em Environment, não aqui.
DATABASE_URL=postgres://usuario:senha@host/nome_do_banco?sslmode=require
